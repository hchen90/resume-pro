{
  "name": "resume-pro",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k -s first -n next,electron \"next dev -p 3000\" \"wait-on http://localhost:3000 && npm run electron:dev\"",
    "release-notes:generate": "node scripts/generate-release-notes.mjs",
    "build": "npm run release-notes:generate && next build",
    "build:electron-main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --out-extension:.js=.cjs --external:electron",
    "build:electron": "npm run build && npm run build:electron-main && node scripts/run-electron-builder.mjs",
    "pack:electron": "npm run build && npm run build:electron-main && node scripts/run-electron-builder.mjs --dir",
    "electron:dev": "npm run build:electron-main && cross-env ELECTRON_RUN_AS_NODE= ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@agentscope-ai/agentscope": "0.0.13",
    "@fontsource/lxgw-wenkai": "^5.2.5",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-sans-mono": "^5.2.10",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@fontsource/noto-serif": "^5.2.9",
    "@fontsource/noto-serif-jp": "^5.2.7",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@fontsource/noto-serif-tc": "^5.2.10",
    "@langchain/core": "^1.1.45",
    "@langchain/openai": "^1.4.5",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
