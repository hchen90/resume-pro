# Copy this file to .env before running locally.

# Database
DATABASE_PROVIDER=sqlite
SQLITE_PATH=./data/resume-pro.sqlite

# To use Postgres instead:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/resume_pro

# AI - OpenAI-compatible LangChain configuration
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_MODEL=gpt-4o-mini
# Optional. Chat-history summarization model. Falls back to AI_API_MODEL when unset.
AI_SUMMARY_MODEL=

# AI chat history
AI_HISTORY_MAX_MESSAGES=50
AI_HISTORY_SUMMARIZE_ABOVE=30
AI_HISTORY_CONTEXT_MESSAGES=20

# Runtime target
# APP_TARGET=web is the default for browser/Docker.
# Electron reads ~/.resume-pro/.env and creates a default file if it is missing.
APP_TARGET=web
