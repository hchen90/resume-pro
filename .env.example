# Copy this file to .env before running locally.

# Database (legacy — only needed to migrate old data into the workspace)
# DATABASE_PROVIDER=sqlite
# SQLITE_PATH=./data/resume-pro.sqlite

# Workspace folder (source of truth for resumes, JDs, and AI sessions)
WORKSPACE_PATH=./data/workspace

# To migrate from a legacy database once:
#   npm run workspace:migrate
#   npm run workspace:migrate -- --force

# To use Postgres for migration instead:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/resume_pro

# AI - OpenAI-compatible configuration
# Assistant runtime: AgentScope (@agentscope-ai/agentscope@0.0.13) in Node.js routes.
# Job Match still uses LangChain ChatOpenAI with the same env vars.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_MODEL=gpt-4o-mini
# Optional. Sampling temperature (default 0.3). Some models only accept 1.
AI_TEMPERATURE=0.3
# Optional. Chat-history summarization model. Falls back to AI_API_MODEL when unset.
AI_SUMMARY_MODEL=

# AgentScope skills
# Bundled skills under ./skills/resume-assistant are enabled by default.
AI_SKILLS_ENABLED=true
# Optional comma-separated or JSON-array paths. Relative paths resolve from the app working directory.
AI_SKILL_DIRS=
# Optional individual skill directories, each containing SKILL.md.
AI_SKILLS=

# AI chat history
AI_HISTORY_MAX_MESSAGES=50
AI_HISTORY_SUMMARIZE_ABOVE=30
AI_HISTORY_CONTEXT_MESSAGES=20

# Runtime target
# APP_TARGET=web is the default for browser/Docker.
# Electron reads ~/.resume-pro/.env and creates a default file if it is missing.
APP_TARGET=web
